{
	"schemaVersion": 1,
	"id": "cauldroncolors",
	"version": "${version}",
	"name": "Cauldron Colors",
	"description": "Allows eggs to be colored in the cauldron.",
	"authors": [
		"Robby Robb"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/cauldroncolors/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.cauldroncolors.CauldronColors"
		],
		"client": [
			"com.example.cauldroncolors.client.CauldronColorsClient"
		],
		"fabric-datagen": [
			"com.example.cauldroncolors.data.CauldronColorsDataGenerator"
		]
	},
	"mixins": [
		"cauldroncolors.mixins.json",
		{
			"config": "cauldroncolors.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
